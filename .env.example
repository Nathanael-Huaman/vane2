# Base de datos
# SQLite en desarrollo, PostgreSQL en produccion
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth
AUTH_SECRET="genera-un-secreto-largo-y-seguro"
AUTH_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID="tu-google-client-id"
AUTH_GOOGLE_SECRET="tu-google-client-secret"

# Email (recuperacion de contrasena)
EMAIL_SERVER_HOST="smtp.ejemplo.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="usuario"
EMAIL_SERVER_PASSWORD="contraseña"
EMAIL_FROM="noreply@obsedesign.com"

# URL publica de la aplicacion
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Entorno
NODE_ENV="development"
