# Base de datos
# Desarrollo: SQLite con archivo local
DATABASE_URL="file:./dev.db"
# Producción: PostgreSQL (descomentar y ajustar credenciales)
# DATABASE_URL="postgresql://usuario:contraseña@host:5432/obstedesign"

# Auth.js / NextAuth
AUTH_SECRET="genera-un-secreto-largo-y-seguro"
AUTH_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID="tu-google-client-id"
AUTH_GOOGLE_SECRET="tu-google-client-secret"

# Email transaccional (Brevo)
BREVO_API_KEY="xkeysib-tu-api-key-de-brevo"
EMAIL_FROM="noreply@obsedesign.com"
EMAIL_FROM_NAME="Obstedesign"

# URL publica de la aplicacion
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Server Actions trusted origins (optional; only for proxy/Coolify deployments)
# Leave unset for the default same-host posture: Next.js POST-only Server Actions plus Origin-to-Host verification.
# If a proxy requires alternate first-party hosts, list exact host[:port] entries without scheme, path, query, wildcard, or null-origin values.
# SERVER_ACTION_ALLOWED_ORIGINS="tienda.obstedesign.com,checkout.obstedesign.com:8443"

# Entorno
NODE_ENV="development"

# Rate limiting (public mutations)
# Production deploys must set real shared-store values in the deploy provider.
# Do not deploy with placeholder RATE_LIMIT_* values.
# Coolify/VPS production should use a managed Redis TCP service via REDIS_URL.
# REST-compatible Redis/Upstash variables remain supported as a fallback/alternative.
RATE_LIMIT_KEY_SECRET="genera-un-secreto-hmac-largo"
# REDIS_URL="redis://usuario:contraseña@coolify-redis:6379"
# RATE_LIMIT_REST_URL="https://tu-redis-upstash.upstash.io"
# RATE_LIMIT_REST_TOKEN="tu-token-rest"

# Security headers / CSP rollout (report-only|enforce|off)
SECURITY_HEADERS_CSP_MODE="report-only"

# Usuarios de prueba para E2E
TEST_CLIENTE_EMAIL="cliente.prueba@obstedesign.local"
TEST_CLIENTE_PASSWORD="Cliente123!"
TEST_ADMIN_EMAIL="admin.prueba@obstedesign.local"
TEST_ADMIN_PASSWORD="Admin12345!"
